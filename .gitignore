# Staged offline artefacts: model snapshots and caches, tens of GB.
offline_assets/

# Per-machine Docker settings (UID/GID, model paths, GPU selection).
.env

# Corpora and derived splits. sft_farsi_science.jsonl alone is ~140 MB, over
# GitHub's per-file limit, and it is transferred to the offline host alongside
# the model tarball rather than through git.
data/*
!data/.gitkeep

# Run outputs.
translategemma-farsi-science/
evaluation/
# Evaluation runs are named per adapter/date; all are generated output.
evaluation*/
logs/

# Shipping tarballs.
*.tar
*.tar.zst
*.tar.gz

# Prebuilt CUDA wheels (FlashAttention 3). Hundreds of MB of ABI-specific
# binary, rebuilt by scripts/build_flash_attn3_wheel.sh rather than tracked.
wheels/*.whl
wheels/*.whl.part*
.cache/flash-attn3/

__pycache__/
*.pyc
.venv/
.ruff_cache/
.pytest_cache/

# Local/reference design documents used during implementation review.
docs/refs/
docs/MULTI_GPU_TRAINING.md
# Research journal for the OpenWebUI integration (internal investigation notes).
docs/OPENWEBUI_INTEGRATION_RESEARCH.md
# OpenWebUI x Wan2.2-T2V (vllm-omni) integration guides — target the prod
# machine deployment (vllm-omni port, Docker network, proxy settings).
docs/OPENWEBUI_WAN22_INTEGRATION.md
docs/OPENWEBUI_WAN22_PIPE_INTEGRATION.md
docs/EVALUATION_BACKLOG.md
docs/EVALUATION_METRICS_EXPLAINED.md
docs/GLOSSARY_FA.md
docs/2026-08-27_finetune_volume_benchmark_methodology.md
docs/2026-08-27_domain_adaptation_without_forgetting.md

# Speed-benchmark reports, produced per host by api/scripts/benchmark_speed.py.
api/benchmarks/

# A/B serving benchmark: host-specific paths, and reports produced per host by
# scripts/bench_ab.sh. .env.bench.example is the tracked template.
.env.bench
benchmark_ab/
