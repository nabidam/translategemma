# Environment for the A/B serving benchmark. Copy to .env.bench on the GPU host
# and fill in the four paths. See docs/SERVING_BENCHMARK_AB.md.

# --- Checkpoints ----------------------------------------------------------
# All paths are on the HOST and must be ABSOLUTE: a relative volume source is
# parsed by Compose as a named volume, not a bind mount.
#
# Arm A serves this: base + LoRA already folded in by
# scripts/merge_lora_adapter.py. Must be the bf16 merge, not the fp8 quant --
# serving fp8 on one arm folds a quantisation effect into a runtime question.
TG_MERGED_MODEL_DIR=/abs/path/to/translategemma-12b-merged

# Arm B loads the SAME base and the SAME adapter, applied at run time instead
# of ahead of time. TG_BASE_MODEL_DIR is what gets MOUNTED (at /base) and
# TG_BASE_MODEL_PATH is where the checkpoint sits inside that mount.
#
# They differ for a model in the HuggingFace cache: cache snapshot directories
# are symlinks into ../../blobs/, so mounting a snapshot alone leaves every
# weight file dangling. Mount the cache root and address the snapshot inside it:
TG_BASE_MODEL_DIR=/abs/path/to/.cache/huggingface
TG_BASE_MODEL_PATH=/base/hub/models--google--translategemma-12b-it/snapshots/d1b225e1caa17f1ddc7e62065d8637d0923f34e2
# For a standalone (non-cache) checkpoint directory, mount it directly instead:
#   TG_BASE_MODEL_DIR=/abs/path/to/translategemma-12b-it
#   TG_BASE_MODEL_PATH=/base

TG_ADAPTER_DIR=/abs/path/to/adapters/farsi-science
# Shared HF cache, mounted read-only into the API containers.
HF_CACHE_DIR=/abs/path/to/.cache/huggingface

# --- Images ---------------------------------------------------------------
# Arm A's CPU-only gateway, built from HEAD's api/. Also runs the benchmark
# client, which needs Settings.vllm_base_url and translator.load_processor and
# so cannot run in the arm-B image.
TG_API_IMAGE=translategemma-api-gw:latest
# Arm B, built from the tree at 21e5ab0^. Both Dockerfiles say
# `-t translategemma-api` in their headers, so tag both explicitly and check
# what an existing translategemma-api image actually is; see the runbook.
TG_API_HF_IMAGE=translategemma-api-hf:latest
VLLM_IMAGE_TAG=v0.13.0

# --- Hardware -------------------------------------------------------------
GPU_DEVICE_ID=0
# Nothing else shares the card during a benchmark, so vLLM gets nearly all of
# it. KV budget is where its batching headroom comes from; starving it here
# would understate arm A.
TG_GPU_MEMORY_UTILIZATION=0.90
TG_MAX_MODEL_LEN=8192
TG_DTYPE=bfloat16

# --- What is measured -----------------------------------------------------
TG_MAX_NEW_TOKENS=512
TG_SOURCE_LANG=en
TG_TARGET_LANG=fa
BENCH_OUTPUT_DIR=./benchmark_ab
