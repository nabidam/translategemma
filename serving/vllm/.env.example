# Environment configuration for vLLM serving container
VLLM_IMAGE=vllm/vllm-openai:v0.13.0
MODEL_DIR=/opt/models/translategemma/current
SERVED_MODEL_NAME=translategemma
MAX_MODEL_LEN=4096
GPU_MEMORY_UTILIZATION=0.90
MAX_NUM_SEQS=128
MAX_NUM_BATCHED_TOKENS=8192
TENSOR_PARALLEL_SIZE=1
VLLM_PORT=8000
CUDA_VISIBLE_DEVICES=0
