# Environment configuration for the TranslateGemma serving stack.
# VLLM_IMAGE overrides the compose default, so it must itself be digest-pinned:
# an unpinned tag here silently defeats the pin and fails the deployment preflight.
VLLM_IMAGE=vllm/vllm-openai:v0.13.0@sha256:7b5cf896b0105374bebb974c0529d47913364f33161c5ca155452f1e29e96ee1
MODEL_DIR=/opt/models/translategemma/current
SERVED_MODEL_NAME=translategemma
MAX_MODEL_LEN=4096
GPU_MEMORY_UTILIZATION=0.90
MAX_NUM_SEQS=128
MAX_NUM_BATCHED_TOKENS=8192
TENSOR_PARALLEL_SIZE=1
VLLM_PORT=8000
CUDA_VISIBLE_DEVICES=0

# Gateway build: digest-pinned base image is mandatory (see serving/COMPATIBILITY.md).
PYTHON_BASE_IMAGE=python:3.11-slim@sha256:<pinned-digest>

# Release trust chain (serving/docker-compose.yml). The anchor directory must live
# OUTSIDE the model release and is mounted read-only at /trust.
TRUSTED_ANCHOR_DIR=/opt/models/translategemma/anchors
TRUSTED_ANCHOR_FILE=/trust/current.sha256
REQUIRE_VERIFIED_MANIFEST=true
REQUIRE_VERIFIED_PAYLOAD=true
REQUIRE_EXACT_TOKENIZER=true
EXPOSE_FULL_MANIFEST=false
