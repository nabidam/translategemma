# --- What to load --------------------------------------------------------
TG_BASE_MODEL_ID=google/translategemma-12b-it
TG_MODEL_MODE=base
# TG_ADAPTER_PATH=/models/adapters/translategemma-farsi-science/sft_final

# --- How to load ---------------------------------------------------------
TG_DTYPE=bfloat16
TG_ATTN_IMPLEMENTATION=sdpa
TG_LOAD_IN_4BIT=true

# --- Request defaults ----------------------------------------------------
TG_SOURCE_LANG=en
TG_TARGET_LANG=fa
TG_MAX_NEW_TOKENS=1024
TG_DO_SAMPLE=false
TG_TEMPERATURE=1.0
TG_TOP_P=1.0
TG_NUM_BEAMS=1

# --- Batching ------------------------------------------------------------
TG_BATCH_SIZE=8
TG_MAX_BATCH_ITEMS=128
TG_SPLIT_SENTENCES=false

# --- CORS ----------------------------------------------------------------
TG_CORS_ORIGINS=*
TG_CORS_ALLOW_CREDENTIALS=true
TG_CORS_ALLOW_METHODS=*
TG_CORS_ALLOW_HEADERS=*

# --- Offline serving & CUDA ----------------------------------------------
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1