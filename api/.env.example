# --- Upstream vLLM -------------------------------------------------------
# Required by the default docker-compose.yml (gateway alone): it names a vLLM
# running somewhere else, and compose refuses to start without it. Include the
# /v1 suffix. Same host but outside compose: http://host.docker.internal:8001/v1
# docker-compose.full.yml sets it to its own vLLM service and ignores this.
TG_VLLM_BASE_URL=http://localhost:8001/v1
# Must match vLLM's --served-model-name.
TG_VLLM_MODEL=model
TG_VLLM_TIMEOUT=300
TG_VLLM_MAX_RETRIES=2
TG_MAX_CONCURRENT_REQUESTS=32
# TG_VLLM_API_KEY=

# --- What is served ------------------------------------------------------
TG_BASE_MODEL_ID=/models/translategemma-12b-merged
TG_SERVED_SYSTEM=adapter

# --- Request defaults ----------------------------------------------------
TG_SOURCE_LANG=en
TG_TARGET_LANG=fa
TG_MAX_NEW_TOKENS=1024
TG_DO_SAMPLE=false
TG_TEMPERATURE=1.0
TG_TOP_P=1.0

# --- Batching ------------------------------------------------------------
# Prompts per upstream request. vLLM does the GPU batching itself.
TG_BATCH_SIZE=8
TG_MAX_BATCH_ITEMS=128
TG_SPLIT_SENTENCES=false

# --- CORS ----------------------------------------------------------------
TG_CORS_ORIGINS=*
TG_CORS_ALLOW_CREDENTIALS=true
TG_CORS_ALLOW_METHODS=*
TG_CORS_ALLOW_HEADERS=*

# --- Offline serving -----------------------------------------------------
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# --- Glossary (optional; off by default) -------------------------------------
# Deterministic terminology. When false the feature is absent: no database is
# opened, no admin routes exist, and the tokens sent to vLLM are unchanged.
TG_GLOSSARY_ENABLED=false
# Must live on a mounted volume, never inside the container filesystem.
TG_GLOSSARY_DB_URL=sqlite+aiosqlite:////data/glossary.db
# Required when the glossary is enabled. The only authorization boundary on the
# admin routes; startup fails without it.
TG_ADMIN_API_KEY=
# Applied when a request omits `domain`. Lets a single-field deployment pin its
# termbase without callers knowing domains exist.
TG_GLOSSARY_DEFAULT_DOMAIN=
# reject: an unknown domain name is a 404. fallback: use the global termbase.
TG_GLOSSARY_UNKNOWN_DOMAIN=reject
TG_TERMINOLOGY_MODE=enforce
