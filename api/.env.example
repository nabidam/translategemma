# Copy to .env in this directory for local runs, and start the server from here
# (the file is read relative to the working directory). In Docker, prefer
# setting these in the compose file's `environment:` block so the image stays
# reusable across checkpoints.

# --- What to load --------------------------------------------------------
# A hub id, or a path inside the container (mount the model tree there).
TG_BASE_MODEL_ID=google/translategemma-12b-it

# base    : the untouched checkpoint only.
# adapter : base + LoRA adapter, the fine-tuned system only.
# both    : one copy of the weights, adapter toggled per request, so a caller
#           can ask either system with "system": "base" | "adapter". Costs the
#           adapter's few hundred MB, not a second 12B model.
TG_MODEL_MODE=adapter

# Required unless TG_MODEL_MODE=base. Validated at startup: a directory without
# adapter_config.json is otherwise treated as a Hub repo id by PEFT and fails
# minutes later with an unrelated-looking network error.
TG_ADAPTER_PATH=/models/adapters/translategemma-farsi-science/sft_final

# Which system answers a request that does not name one. Defaults to the only
# loaded system, or to "adapter" under TG_MODEL_MODE=both.
# TG_DEFAULT_SYSTEM=adapter

# --- How to load ---------------------------------------------------------
TG_DTYPE=bfloat16
# "sdpa" everywhere; "flash_attention_3" only on Hopper with the FA3 wheel
# installed in the image.
TG_ATTN_IMPLEMENTATION=sdpa
# 4-bit weights: less VRAM, slower per token.
TG_LOAD_IN_4BIT=false
# Leave unset to pick cuda:0 when available, else cpu.
# TG_DEVICE=cuda:0

# --- Prompt rendering ----------------------------------------------------
# Each system is queried the way it was trained. Change these only when serving
# MERGED adapter weights as the base system (TG_MODEL_MODE=base with
# TG_BASE_MODEL_ID pointing at the merged checkpoint): that model still expects
# the SFT rendering, so it needs TG_BASE_USE_TRAINING_RENDERING=true.
# TG_BASE_USE_TRAINING_RENDERING=false
# TG_ADAPTER_USE_TRAINING_RENDERING=true

# --- Request defaults ----------------------------------------------------
TG_SOURCE_LANG=en
TG_TARGET_LANG=fa
TG_MAX_NEW_TOKENS=512
# Greedy decoding, matching the evaluation harness. Translation does not benefit
# from sampling, and determinism keeps a served translation comparable with the
# evaluated one.
TG_DO_SAMPLE=false
TG_TEMPERATURE=1.0
TG_TOP_P=1.0
TG_NUM_BEAMS=1

# --- Batching ------------------------------------------------------------
# Segments per generate() call. Raise for throughput, lower on OOM.
TG_BATCH_SIZE=8
# Cap on items in one /translate/batch request.
TG_MAX_BATCH_ITEMS=128

# --- Sentence splitting --------------------------------------------------
# Off by default: the adapter was trained on whole segments. Turn on for long
# free text, or override per request with "split_sentences": true.
TG_SPLIT_SENTENCES=false

# --- Offline serving -----------------------------------------------------
# Point at the staged model tree and fail loudly on any accidental network call.
# HF_HOME=/models
# HUGGINGFACE_HUB_CACHE=/models/hub
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
