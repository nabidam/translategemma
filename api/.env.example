# --- Upstream vLLM -------------------------------------------------------
# The weights live here; this service renders prompts and forwards them.
TG_VLLM_BASE_URL=http://localhost:8001/v1
# Must match vLLM's --served-model-name.
TG_VLLM_MODEL=model
TG_VLLM_TIMEOUT=300
TG_VLLM_MAX_RETRIES=2
TG_MAX_CONCURRENT_REQUESTS=32
# TG_VLLM_API_KEY=

# --- What is served ------------------------------------------------------
# The checkpoint vLLM serves. Read locally for the tokenizer and chat template
# only; no weights are loaded in this process.
TG_BASE_MODEL_ID=/models/translategemma-12b-merged
TG_MODEL_MODE=adapter
# Provenance only: with a merged checkpoint the adapter is already in the
# weights vLLM serves.
# TG_ADAPTER_PATH=/models/adapters/translategemma-farsi-science/sft_final
# Override when the tokenizer does not live with TG_BASE_MODEL_ID.
# TG_TOKENIZER_PATH=

# --- How the upstream was loaded (reported by /model-info, applied by vLLM) --
TG_DTYPE=bfloat16
TG_ATTN_IMPLEMENTATION=sdpa
TG_LOAD_IN_4BIT=false

# --- Request defaults ----------------------------------------------------
TG_SOURCE_LANG=en
TG_TARGET_LANG=fa
TG_MAX_NEW_TOKENS=1024
TG_DO_SAMPLE=false
TG_TEMPERATURE=1.0
TG_TOP_P=1.0
# Ignored: the vLLM completions API has no beam search.
TG_NUM_BEAMS=1

# --- Batching ------------------------------------------------------------
# Prompts per upstream request. vLLM does the GPU batching itself.
TG_BATCH_SIZE=8
TG_MAX_BATCH_ITEMS=128
TG_SPLIT_SENTENCES=false

# --- CORS ----------------------------------------------------------------
TG_CORS_ORIGINS=*
TG_CORS_ALLOW_CREDENTIALS=true
TG_CORS_ALLOW_METHODS=*
TG_CORS_ALLOW_HEADERS=*

# --- Offline serving -----------------------------------------------------
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
