# Backend vLLM connection
TG_VLLM_BASE_URL=http://vllm:8000/v1
TG_VLLM_MODEL_NAME=translategemma
TG_VLLM_TIMEOUT_SECONDS=60.0
TG_VLLM_CONNECT_TIMEOUT_SECONDS=5.0
TG_VLLM_MAX_MODEL_LEN=4096

# Model & Tokenizer directory (mounted read-only)
TG_MODEL_DIR=/models/model
TG_TOKENIZER_PATH=/models/model
TG_REQUIRE_EXACT_TOKENIZER=true

# Serving defaults & Provenance
TG_MODEL_RELEASE_ID=tg-12b-merged-20260816
TG_BASE_MODEL_ID=google/translategemma-12b-it
TG_SOURCE_ADAPTER_PATH=checkpoints/sft-translategemma-12b-it
TG_DEFAULT_SYSTEM=adapter
TG_SOURCE_LANG=en
TG_TARGET_LANG=fa
TG_MAX_NEW_TOKENS=512
TG_SPLIT_SENTENCES=false

# Concurrency & Admission Limits
TG_MAX_CONCURRENT_REQUESTS=64
TG_MAX_BULK_CONCURRENT_REQUESTS=16
TG_MAX_QUEUE_DEPTH=128
TG_MAX_REQUEST_BODY_BYTES=1000000
TG_MAX_BATCH_ITEMS=128
TG_MAX_BATCH_TOTAL_CHARS=200000
TG_MAX_SOURCE_CHARS_PER_TEXT=50000
TG_MAX_ESTIMATED_SOURCE_TOKENS=3584
TG_MAX_TOTAL_CONTEXT_TOKENS=4096

# Server
TG_HOST=0.0.0.0
TG_PORT=8080
TG_WORKERS=1
TG_LOG_LEVEL=INFO
