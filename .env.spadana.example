# Single configuration file for docker-compose.spadana.yml. Copy to `.env`
# BESIDE the compose file -- Compose reads it from the directory it runs in, not
# from the source tree.
#
# It has two jobs at once:
#
#   * Compose interpolation. Every ${NAME} in the compose file is substituted
#     from here before any container starts. These are HOST paths and sizing
#     knobs; a container never sees them.
#   * Container environment. The gateway service declares `env_file: .env`, so
#     every key below is also handed to that process, which reads the TG_ ones
#     through pydantic-settings. Unknown names are ignored, so the MySQL and
#     vLLM keys sitting here are inert inside it.
#
# The one thing NOT to put here is a variable the compose file already sets
# under `environment:`. That block wins over this file, so a copy here would be
# silently dead -- right up until someone deletes the compose line and the stale
# value takes over. There is exactly one such key, TG_VLLM_MODEL, and the reason
# is at the bottom of this file.

# =========================================================================
# Host paths and hardware (Compose interpolation only)
# =========================================================================
# A rope overlay built by scripts/vllm_rope_shim.py, NOT the merge itself:
# vLLM 0.13.0 cannot load a Gemma 3 config written by Transformers 4.57. See
# section 5.7 of docs/OFFLINE_DEPLOYMENT.md.
#
#   python scripts/vllm_rope_shim.py <merge> <merge>-vllm
#
# Both TranslateGemma services mount it. That is deliberate: the overlay
# rewrites config.json only, so its tokenizer is the merge's tokenizer, and the
# gateway must render prompts with the same tokenizer vLLM generates from.
TG_MERGED_MODEL_DIR=/absolute/path/to/translategemma-12b-merged-vllm

# Which physical card both vLLM servers divide.
GPU_DEVICE_ID=0
# Fractions of TOTAL VRAM, not of what is free -- that is what stops two servers
# starting in any order from claiming the same bytes. Must sum below 1.0.
TG_GPU_MEMORY_UTILIZATION=0.55
DOTS_GPU_MEMORY_UTILIZATION=0.30
# KV-cache budget, not a request-size limit. Raising it costs concurrency.
TG_MAX_MODEL_LEN=8192
# vLLM's --dtype. Not a gateway setting: that process loads no weights.
VLLM_DTYPE=bfloat16

SERVED_TG_MODEL_NAME=translategemma
SERVED_DOT_MODEL_NAME=model

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=fundamental
# Optional; both vLLM servers run with HF_HUB_OFFLINE=1 anyway.
HUGGING_FACE_HUB_TOKEN=

# =========================================================================
# Gateway wiring (container environment)
# =========================================================================
# These are CONTAINER-internal, and each one must agree with something else in
# the compose file. Changing one without the other breaks the stack.

# The service name on the compose network. Never a published port: 8888 is this
# gateway's own port, and pointing it there makes the process call itself.
TG_VLLM_BASE_URL=http://translategemma-vllm:8000/v1
# Must match the /merged mount target above.
TG_BASE_MODEL_ID=/merged
# Must match the /models mount target above.
HF_HOME=/models
# Which system the mounted weights are: "adapter" (carrying the SFT adapter,
# merged or otherwise) or "base" (untouched upstream checkpoint). This selects
# the prompt rendering, and getting it wrong is silent -- generation still
# returns fluent Farsi, from a prefix the model was never conditioned on.
TG_SERVED_SYSTEM=adapter

HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# =========================================================================
# Gateway tuning (container environment)
# =========================================================================
# Nothing below decides whether the stack works, only how it behaves.

TG_VLLM_TIMEOUT=300
TG_VLLM_MAX_RETRIES=2
TG_MAX_CONCURRENT_REQUESTS=32
# TG_VLLM_API_KEY=

TG_SOURCE_LANG=en
TG_TARGET_LANG=fa
TG_MAX_NEW_TOKENS=1024
TG_DO_SAMPLE=false
TG_TEMPERATURE=1.0
TG_TOP_P=1.0

# Prompts per upstream request. vLLM does the GPU batching itself.
TG_BATCH_SIZE=8
TG_MAX_BATCH_ITEMS=128
TG_SPLIT_SENTENCES=false

TG_CORS_ORIGINS=*
TG_CORS_ALLOW_CREDENTIALS=true
TG_CORS_ALLOW_METHODS=*
TG_CORS_ALLOW_HEADERS=*

# =========================================================================
# TG_VLLM_MODEL is deliberately absent
# =========================================================================
# It must equal vLLM's --served-model-name, which the compose file builds from
# SERVED_TG_MODEL_NAME above. As a second literal here the two could drift, and
# a mismatch is a 404 from the upstream on every single request. So the compose
# file maps it instead:
#
#     environment:
#       TG_VLLM_MODEL: ${SERVED_TG_MODEL_NAME:-translategemma}
#
# Set SERVED_TG_MODEL_NAME above and both sides follow it.
