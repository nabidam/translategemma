# Copy to .env on each machine:  cp .env.example .env
# Then:  printf 'HOST_UID=%s\nHOST_GID=%s\n' "$(id -u)" "$(id -g)" >> .env

IMAGE_NAME=translategemma
IMAGE_TAG=cu130-py312

# Match the host user so files written into the bind mounts stay owned by you.
HOST_UID=1000
HOST_GID=1000

# Output of `fetch_offline_assets.py --dest`. Contains hub/models--*, and becomes
# HF_HOME inside the container. Must match the --dest you staged with.
MODELS_DIR=./offline_assets/models

# Scratch cache (HOME / XDG_CACHE_HOME inside the container). Safe to wipe.
HF_CACHE_DIR=./offline_assets/hf_cache

# "all", or a specific index list such as "0" / "0,1".
GPUS=all

# Set to 0 to build without MetricX (also set evaluation.metricx_enabled: false).
INSTALL_METRICX=1
